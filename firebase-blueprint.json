{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "A registered member of the group.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cargo": { "type": "string" },
        "createdAt": { "type": "number", "description": "Unix timestamp in milliseconds" }
      },
      "required": ["name", "createdAt"]
    },
    "AttendanceRecord": {
      "title": "Attendance Record",
      "description": "Information about a member's attendance in a specific session.",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "status": { "type": "string", "enum": ["presente", "ausente", "falta_justificada"] },
        "justification": { "type": "string" }
      },
      "required": ["memberId", "memberName", "status"]
    },
    "Society": {
      "title": "Society",
      "description": "A group representing a society.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "Vote": {
      "title": "Vote",
      "description": "A cast vote.",
      "type": "object",
      "properties": {
        "voterId": { "type": "string" },
        "candidateId": { "type": "string" },
        "role": { "type": "string", "enum": ["PRESIDENT", "VICE", "SECRETARY", "TREASURER"] },
        "ballotNumber": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["voterId", "candidateId", "role", "ballotNumber", "timestamp"]
    },
    "Election": {
      "title": "Election",
      "description": "An election instance.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "currentRole": { "type": "string", "enum": ["PRESIDENT", "VICE", "SECRETARY", "TREASURER"] },
        "currentBallot": { "type": "number" },
        "votes": { "type": "array", "items": { "$ref": "Vote" } },
        "archived": { "type": "boolean" }
      },
      "required": ["name", "currentRole", "currentBallot", "votes"]
    }
  },
  "firestore": {
    "members": {
      "schema": "Member",
      "description": "Collection of all registered members."
    },
    "attendanceSessions": {
      "schema": "AttendanceSession",
      "description": "Collection of attendance sessions with member records."
    },
    "societies": {
      "schema": "Society",
      "description": "Collection of societies."
    },
    "elections": {
      "schema": "Election",
      "description": "Collection of elections."
    }
  }
}
