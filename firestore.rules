rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isVoter() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Members (Admins mutate; all signed in can read directory)
    match /members/{memberId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin() && incoming().keys().hasAll(['name', 'createdAt']) && isValidMember(incoming()) && isValidId(memberId);
      allow update: if isAdmin() && isValidMember(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'cargo', 'pinCode', 'uphEntryDate'])
      );
      allow delete: if isAdmin();
    }

    function isValidMember(data) {
      return (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 100))
        && (!('cargo' in data) || data.cargo == null || (data.cargo is string && data.cargo.size() <= 100))
        && (!('pinCode' in data) || data.pinCode == null || (data.pinCode is string && data.pinCode.size() >= 4 && data.pinCode.size() <= 10))
        && (!('uphEntryDate' in data) || data.uphEntryDate == null || data.uphEntryDate is string)
        && (!('createdAt' in data) || data.createdAt == null || data.createdAt is number || data.createdAt is timestamp);
    }

    // 2. Voter PINs Lookup (Safe hashed verification without list capability)
    match /voterPins/{pinHash} {
      allow get: if isSignedIn();
      allow list: if isAdmin(); // Voters cannot list/enumerate PINs
      allow create, update, delete: if isAdmin();
    }

    // 3. Attendance Sessions (Admins can create, update and delete. Rectifications allowed!)
    match /attendanceSessions/{sessionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin() && incoming().keys().hasAll(['date', 'records', 'type']) && isValidSession(incoming()) && isValidId(sessionId);
      allow update: if isAdmin() && isValidSession(incoming());
      allow delete: if isAdmin();
    }

    function isValidSession(data) {
      return (!('date' in data) || (data.date is number))
        && (!('type' in data) || (data.type in ['programacao', 'plenaria']))
        && (!('callNumber' in data) || (data.callNumber in [1, 2]))
        && (!('records' in data) || (data.records is list && data.records.size() > 0 && data.records.size() <= 600 && isValidRecord(data.records[0])));
    }

    function isValidRecord(record) {
      return (!('memberId' in record) || record.memberId is string)
        && (!('memberName' in record) || record.memberName is string)
        && (!('status' in record) || record.status in ['presente', 'ausente', 'falta_justificada']);
    }
    
    // 4. Societies
    match /societies/{societyId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin() && incoming().keys().hasAll(['name']) && isValidSociety(incoming()) && isValidId(societyId);
      allow update: if isAdmin() && isValidSociety(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name'])
      );
      allow delete: if isAdmin();
    }

    function isValidSociety(data) {
      return (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 100));
    }

    // 5. Elections & Secret Ballots
    match /elections/{electionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin() && incoming().keys().hasAll(['name', 'currentRole', 'currentBallot', 'quorumRequired', 'presentCount']) && isValidElection(incoming()) && isValidId(electionId);
      allow update: if isSignedIn() && isValidElection(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['currentRole', 'currentBallot', 'votes', 'archived', 'candidatesIds', 'presentCount', 'quorumRequired', 'declinedMembers', 'registeredCandidates', 'ballotsCount', 'votedCount'])
      );
      allow delete: if isAdmin();

      // Subcollection: Registered Voters (Tracks who voted - no candidate info)
      match /voters/{voterId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }

      // Subcollection: Anonymous Ballots (Secret votes - no voter ID info)
      match /ballots/{ballotId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    function isValidElection(data) {
      return (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 100))
        && (!('currentRole' in data) || (data.currentRole in ['PRESIDENT', 'VICE', 'SECRETARY_1', 'SECRETARY_2', 'TREASURER']))
        && (!('currentBallot' in data) || (data.currentBallot is number))
        && (!('votes' in data) || (data.votes is list))
        && (!('quorumRequired' in data) || (data.quorumRequired is number))
        && (!('presentCount' in data) || (data.presentCount is number))
        && (!('candidatesIds' in data) || (data.candidatesIds is list))
        && (!('declinedMembers' in data) || (data.declinedMembers is list))
        && (!('registeredCandidates' in data) || (data.registeredCandidates is list))
        && (!('sessionId' in data) || (data.sessionId is string));
    }

    // 6. Treasury Transactions (Only Admins can mutate)
    match /treasuryTransactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && incoming().keys().hasAll(['date', 'description', 'type', 'amount', 'createdAt']) && isValidTreasuryTransaction(incoming()) && isValidId(transactionId);
      allow update: if isAdmin() && isValidTreasuryTransaction(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['date', 'description', 'type', 'amount', 'category', 'sheetName'])
      );
      allow delete: if isAdmin();
    }

    function isValidTreasuryTransaction(data) {
      return (!('date' in data) || (data.date is number))
        && (!('description' in data) || (data.description is string && data.description.size() <= 200))
        && (!('type' in data) || (data.type in ['income', 'expense']))
        && (!('amount' in data) || (data.amount is number))
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('sheetName' in data) || data.sheetName == null || (data.sheetName is string && data.sheetName.size() <= 100))
        && (!('createdAt' in data) || data.createdAt == null || data.createdAt is number || data.createdAt is timestamp);
    }
  }
}
