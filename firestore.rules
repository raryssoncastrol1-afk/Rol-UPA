rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Members
    match /members/{memberId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidMember(incoming()) && isValidId(memberId);
      allow update: if isSignedIn() && isValidMember(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'cargo'])
      );
      allow delete: if isSignedIn();
    }

    function isValidMember(data) {
      return data.keys().hasAll(['name', 'createdAt']) 
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (data.get('cargo', '') is string && data.get('cargo', '').size() <= 100)
        && data.createdAt is number;
    }

    // 2. Attendance Sessions
    match /attendanceSessions/{sessionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidSession(incoming()) && isValidId(sessionId);
      allow update: if false; // Sessions are immutable in this app (once saved, they are historic)
      allow delete: if isSignedIn();
    }

    function isValidSession(data) {
      return data.keys().hasAll(['date', 'records', 'type'])
        && data.date is number 
        && data.type in ['programacao', 'plenaria']
        && (data.get('callNumber', 1) in [1, 2])
        && data.records is list && data.records.size() > 0 && data.records.size() <= 500
        && isValidRecord(data.records[0]);
    }

    function isValidRecord(record) {
      return record.keys().hasAll(['memberId', 'memberName', 'status'])
        && record.memberId is string
        && record.memberName is string
        && record.status in ['presente', 'ausente', 'falta_justificada'];
    }
  }
}
